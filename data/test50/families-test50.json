{
  "version": "v3-draft, 10 Oct 2026 · test50 gold (held-out, FHNW TTS audio)",
  "idea": "The LLM readers (QWEN, optionally KEV) only fill facts per family, each with a quote and turn ID. This rule table turns facts into the verdict. Compliance edits the table and the questions in «Regeln», without code.",
  "values": [
    "ja",
    "nein",
    "unklar"
  ],
  "reader_instructions": [
    "Lies das ganze Gespräch. Finde zuerst die Handlung (oft spät im Gespräch), dann den früheren Kontext, der sie bestimmt.",
    "Spätere Warnungen, Ablehnungen oder Abbrüche machen eine erfolgte Handlung nicht rückgängig. Eine Ausführung ist nicht nötig.",
    "Nichts unterstellen: Ist eine nötige Tatsache im Gespräch nicht geklärt, antworte «unklar».",
    "Zu jedem «ja» und «nein» gehört ein wörtliches Zitat mit Turn-ID. Ein Zitat, das nicht im Transkript steht, macht die Antwort ungültig.",
    "Wer spricht, zählt: Beratung oder Kundin."
  ],
  "verdict_rule": [
    "classify_only → no_alert (Information für die Anzeige)",
    "gate = nein → no_alert",
    "ein Slot aus review_if_unklar = unklar → review",
    "alle Slots aus alarm_if = ja → alarm",
    "ein Slot aus alarm_if = nein → no_alert",
    "sonst → review",
    "Gesamturteil eines Calls = schwerstes Urteil über alle Familien (alarm > review > no_alert)"
  ],
  "families": {
    "trade": {
      "label": "Information und Kaufwunsch",
      "gate": "kaufwunsch",
      "alarm_if": [
        "kaufwunsch",
        "info_nicht_oeffentlich",
        "wegen_info"
      ],
      "review_if_unklar": [],
      "slots": {
        "kaufwunsch": "Äussert die Kundin irgendwann einen eigenen Kauf- oder Verkaufswunsch für ein Wertpapier? Eine spätere Ablehnung oder fehlende Ausführung ändert nichts.",
        "info_nicht_oeffentlich": "Stützt sich die Kundin auf Information, die noch nicht öffentlich ist (persönlich gezeigt, intern, vor der Meldung)? Bereits veröffentlichte Berichte = nein.",
        "wegen_info": "Begründet die Kundin den Wunsch ausdrücklich mit genau dieser Information?"
      }
    },
    "access": {
      "label": "Zugangsinformation",
      "gate": "wert_vorgelesen",
      "alarm_if": [
        "wert_vorgelesen",
        "wert_aktiv"
      ],
      "review_if_unklar": [],
      "slots": {
        "wert_vorgelesen": "Liest die Kundin einen Zugangswert (Code, TAN, PIN, Passwort, Bestätigungscode) tatsächlich vor? Nur erwähnen oder verweigern = nein.",
        "wert_aktiv": "Ist dieser Wert beim Vorlesen ein gültiges Geheimnis eines laufenden eigenen Vorgangs? Abgelaufen oder Muster aus einer Anleitung = nein; Herkunft oder Gültigkeit nicht geklärt = unklar."
      }
    },
    "disclosure": {
      "label": "Auskunft an Dritte",
      "gate": "drittinfo_erfragt",
      "alarm_if": [
        "drittinfo_genannt",
        "berechtigung_fehlt"
      ],
      "review_if_unklar": [
        "berechtigung_fehlt"
      ],
      "slots": {
        "drittinfo_erfragt": "Geht es um geschützte Konto- oder Personendaten einer Drittperson?",
        "berechtigung_fehlt": "Hat die Bank festgestellt, dass für genau diese Auskunft keine Berechtigung besteht? Berechtigung bestätigt = nein; Prüfung offen = unklar.",
        "drittinfo_genannt": "Nennt die Beratung tatsächlich ein geschütztes Detail der Drittperson (z. B. Kontostand, Darlehen, Zinstermin)?"
      }
    },
    "documentation": {
      "label": "Relevante Angabe auslassen",
      "gate": "weglass_wunsch",
      "alarm_if": [
        "weglass_wunsch",
        "angabe_relevant"
      ],
      "review_if_unklar": [],
      "slots": {
        "weglass_wunsch": "Bittet die Kundin, eine Angabe absichtlich aus der Dokumentation für eine interne Stelle (z. B. Kredit- oder Finanzierungsstelle) wegzulassen oder zu verbergen? Eine reine Korrektur = nein.",
        "angabe_relevant": "Ist die betroffene Angabe eine richtige, für den Entscheid relevante Tatsache (z. B. bestehende Rückzahlungsverpflichtung)? Falsch oder sachfremd = nein; Bezug offen = unklar."
      }
    },
    "splitting": {
      "label": "Zuständigkeit verhindern",
      "gate": "teilung_angefragt",
      "alarm_if": [
        "teilung_angefragt",
        "ein_vorgang",
        "motiv_umgehung"
      ],
      "review_if_unklar": [],
      "slots": {
        "teilung_angefragt": "Bittet die Kundin, eine Zahlung oder Erfassung in Teilbeträge aufzuteilen?",
        "ein_vorgang": "Gehören die Teilbeträge zu einer einzigen Rechnung oder Lieferung? Unabhängige echte Rechnungen = nein; nicht bekannt = unklar.",
        "motiv_umgehung": "Ist der Zweck ausdrücklich, eine interne Freigabe oder Kontrolle zu verhindern? Nicht bekannt = unklar."
      }
    },
    "numbers": {
      "label": "Zahlenobjekte",
      "classify_only": true,
      "slots": {
        "zahlenobjekt": "Was ist die vorgelesene Zahl laut früherem Feldbezug? Antwort: zahlungsmittel_voll | zahlungsmittel_endstellen | rechnungsreferenz | reservierungsreferenz | betrag_oder_datum | anderes | unklar"
      }
    }
  },
